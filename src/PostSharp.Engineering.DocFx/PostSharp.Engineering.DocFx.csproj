<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>True</IsPackable>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="Docfx.App" />
        <PackageReference Include="JetBrains.Annotations" />
        <PackageReference Include="Spectre.Console.Cli" />
        <PackageReference Include="Docfx.MarkdigEngine.Extensions" />
        <PackageReference Include="HtmlAgilityPack" />
        <PackageReference Include="PKT.LZStringCSharp" />
        <!-- Used by AiSkillSolution. The version must match the one DocFx depends on. -->
        <PackageReference Include="YamlDotNet" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="PostSharp.Engineering.DocFx.Tests" />
    </ItemGroup>

    <ItemGroup>
        <!-- The helper scripts that AiSkillSolution writes into every skill. -->
        <EmbeddedResource Include="AiSkills/Scripts/*" LogicalName="AiSkills.Scripts.%(Filename)%(Extension)" />
    </ItemGroup>
    
    <ItemGroup>
      <ProjectReference Include="..\PostSharp.Engineering.BuildTools\PostSharp.Engineering.BuildTools.csproj" />
    </ItemGroup>
    
    <ItemGroup>
        <Content Include="templates/**" CopyToOutputDirectory="Always" PackageCopyToOutput="true" PackagePath="contentFiles/any/any/templates/overrides" />
    </ItemGroup>
</Project>
