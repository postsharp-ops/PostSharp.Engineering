<Project>

    <!-- Code quality -->
    <PropertyGroup Condition="'$(DisableCodeQuality)'!='True'">
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
        <RunAnalyzersDuringLiveAnalysis>true</RunAnalyzersDuringLiveAnalysis>
        <WarningLevel>4</WarningLevel>
    </PropertyGroup>

    <!-- Documentation: suppress XML doc warnings unless strict mode is enabled -->
    <PropertyGroup Condition="'$(GenerateDocumentationFile)'!='False' AND '$(StrictXmlDocQuality)'!='True'">
        <NoWarn>$(NoWarn);CS1591;CS1572;CS1573</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition="'$(DisableCodeQuality)'!='True' AND '$(ContinuousIntegrationBuild)'=='True'">
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <!-- PSENG0001 reports a use of the obsolete PostSharp.Engineering.BuildTools.Build.PreferredVersions class, whose
         versions moved to ProductFamily.PreferredVersions. The consuming repositories have not been migrated yet, and
         TreatWarningsAsErrors above would turn the diagnostic into a broken build as soon as a repository updates
         PostSharp.Engineering. It is kept as a warning so that it stays visible without stopping the build. Remove this
         line once every consuming repository is migrated, so that a new use cannot be introduced silently. -->
    <PropertyGroup Condition="'$(DisableCodeQuality)'!='True'">
        <WarningsNotAsErrors>$(WarningsNotAsErrors);PSENG0001</WarningsNotAsErrors>
    </PropertyGroup>

</Project>