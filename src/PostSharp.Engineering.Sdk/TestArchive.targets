<Project>

    <!--
        Describes a Microsoft.Testing.Platform test application, and packs it into a zip archive that a test agent runs
        without a .NET SDK. See doc/testing-platform.md.

        Import this file after the body of the project, typically from Directory.Build.targets: the defaults below are
        computed from properties that the project and the .NET SDK set before that point. Being computed at evaluation
        time, they are also what generate-scripts reads to plan the test build configurations, without a build.

        The PublishTestArchive target runs after the build of each target framework. It publishes the application,
        writes the test.psd1 manifest at the root of the published directory, and zips that directory to
        $(TestArchiveDirectory)<AssemblyName>.<TargetFramework>[.<RuntimeIdentifier>].zip. It runs only when
        PublishTestArchive is true, which Build.ps1 build sets for a product that publishes test archives.

        The files that the publication takes from NuGet packages are not in the archive. The Packages key of the manifest
        lists them, with the package they come from, and RunTests.ps1 puts them in place before it runs the application:
        from the NuGet cache of the agent, from nuget.org, or, for a package that a build of the product or of a dependency
        publishes, from artifacts/test-packages, to which the build configuration downloads it. See doc/testing-platform.md.

        Properties that describe the application, read by the archive and by generate-scripts (Build.ps1 test runs
        dotnet test, which does not read them):
            TestApplicationPlatforms        The platforms the application runs on, separated by semicolons, for example
                                            'win-x64;linux-x64'. Defaults to every platform for .NET, and to Windows for
                                            .NET Framework or a Windows-specific target framework.
            TestApplicationTimeoutSeconds   The time after which the application is stopped. Defaults to 1800.
            TestApplicationRunAlone         true when the application must not run at the same time as another one, for
                                            example because its tests measure time.
            TestApplicationSkip             A reason not to run the application. It is reported, and nothing runs.
            TestApplicationPrepareScript    A PowerShell script, relative to the project, that RunTests.ps1 runs before
                                            the application, for example to extract a package that the tests use. It is
                                            packed at the root of the archive. See doc/testing-platform.md.
            TestApplicationArtifacts        The build artifacts that the prepare script reads, separated by semicolons,
                                            as paths relative to the repository in which the file name can contain
                                            wildcards, for example 'artifacts/publish/public/MyProduct.*.nupkg'.
                                            generate-scripts downloads them to the same paths in the build configurations
                                            that run the application. A property and not an item: the wildcards of an
                                            item are expanded at evaluation, before the artifacts exist.

        Items:
            TestApplicationTag              A tag that RunTests.ps1 -Tags and -ExcludeTags select the application by.

        An archive of the ps1 kind (TestApplicationKind=ps1) is described by a project that is not a test application, for
        tests that are not a .NET application, such as a native test executable. RunTests.ps1 runs its entry, a PowerShell
        script, with -Platform and -ResultsDirectory, and the script runs the tests. The project gives the archive its
        files instead of a publication of its own output:
            TestApplicationKind             ps1. The default is a Microsoft.Testing.Platform application.
            TestApplicationEntry            The script, relative to the project. It is packed at the root of the archive.
            TestApplicationReportType       The TeamCity importData type of the reports that the script writes, such as gtest.
            TestApplicationReportFile       Their path, in which {ResultsDirectory} is replaced, and the file name can contain
                                            wildcards, for example '{ResultsDirectory}/*.xml'.
            TestApplicationFile (items)     The files of the archive. The ArchivePath metadata is the path of the file in the
                                            archive, the file name at the root by default.

        Properties of the archive:
            PublishTestArchive              true to produce the archive.
            TestArchiveDirectory            Where the archives go. Defaults to artifacts/tests under the directory of Build.ps1.
    -->

    <PropertyGroup>
        <!-- The SDK gives every .NET Framework executable a runtime identifier, win-x86 by default, which describes the
             build and not a choice of the project. Only a runtime identifier that the project sets describes the
             application. -->
        <TestApplicationRuntimeIdentifier Condition="'$(_UsingDefaultRuntimeIdentifier)' != 'true'">$(RuntimeIdentifier)</TestApplicationRuntimeIdentifier>

        <!-- Windows on ARM64 runs x86 and x64 applications, and not the reverse: a win-arm64 application can carry ARM64
             native assets. -->
        <TestApplicationPlatforms Condition="'$(TestApplicationPlatforms)' == '' AND '$(TestApplicationRuntimeIdentifier)' == 'win-arm64'">win-arm64</TestApplicationPlatforms>
        <TestApplicationPlatforms Condition="'$(TestApplicationPlatforms)' == '' AND $(TestApplicationRuntimeIdentifier.StartsWith('win'))">win-x64;win-arm64</TestApplicationPlatforms>
        <TestApplicationPlatforms Condition="'$(TestApplicationPlatforms)' == '' AND '$(TestApplicationRuntimeIdentifier)' != ''">$(TestApplicationRuntimeIdentifier)</TestApplicationPlatforms>
        <TestApplicationPlatforms Condition="'$(TestApplicationPlatforms)' == '' AND ('$(TargetFrameworkIdentifier)' == '.NETFramework' OR '$(TargetPlatformIdentifier)' == 'windows')">win-x64;win-arm64</TestApplicationPlatforms>
        <TestApplicationPlatforms Condition="'$(TestApplicationPlatforms)' == ''">win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</TestApplicationPlatforms>
        <TestApplicationTimeoutSeconds Condition="'$(TestApplicationTimeoutSeconds)' == ''">1800</TestApplicationTimeoutSeconds>

        <_TestArchiveRepositoryDirectory>$([MSBuild]::GetDirectoryNameOfFileAbove('$(MSBuildProjectDirectory)', 'Build.ps1'))</_TestArchiveRepositoryDirectory>
        <TestArchiveDirectory Condition="'$(TestArchiveDirectory)' == '' AND '$(_TestArchiveRepositoryDirectory)' != ''">$([MSBuild]::NormalizeDirectory('$(_TestArchiveRepositoryDirectory)', 'artifacts', 'tests'))</TestArchiveDirectory>

    </PropertyGroup>

    <!--
        The outer build of a project with several target frameworks has no TargetFramework, and publishes nothing.
        _IsPublishingTestArchive is set on the publication below, which must not start a publication of its own.
    -->
    <Target Name="PublishTestArchive"
            AfterTargets="Build"
            Condition="'$(PublishTestArchive)' == 'true' AND ('$(IsTestingPlatformApplication)' == 'true' OR '$(TestApplicationKind)' == 'ps1') AND '$(TargetFramework)' != '' AND '$(_IsPublishingTestArchive)' != 'true'">

        <Error Text="The test archive of '$(MSBuildProjectName)' cannot be written: TestArchiveDirectory is not set, and there is no Build.ps1 above '$(MSBuildProjectDirectory)'."
               Condition="'$(TestArchiveDirectory)' == ''" />

        <PropertyGroup>
            <_TestArchiveName>$(AssemblyName).$(TargetFramework)</_TestArchiveName>
            <_TestArchiveName Condition="'$(TestApplicationRuntimeIdentifier)' != ''">$(_TestArchiveName).$(TestApplicationRuntimeIdentifier)</_TestArchiveName>
            <_TestArchivePublishDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'test-archive'))</_TestArchivePublishDirectory>
            <_TestArchiveFile>$([MSBuild]::EnsureTrailingSlash('$(TestArchiveDirectory)'))$(_TestArchiveName).zip</_TestArchiveFile>

            <!-- A .NET Framework application is started directly. A .NET application is started with 'dotnet exec', because
                 the application host of the build is for the operating system of the build and not of the test agent. -->
            <_TestArchiveEntry Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">$(TargetName).exe</_TestArchiveEntry>
            <_TestArchiveEntry Condition="'$(TargetFrameworkIdentifier)' != '.NETFramework'">$(TargetFileName)</_TestArchiveEntry>

            <_TestArchiveKind>mtp</_TestArchiveKind>
            <_TestArchiveKind Condition="'$(TestApplicationKind)' == 'ps1'">ps1</_TestArchiveKind>
            <_TestArchiveEntryPath Condition="'$(_TestArchiveKind)' == 'ps1'">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(TestApplicationEntry)'))</_TestArchiveEntryPath>
            <_TestArchiveEntry Condition="'$(_TestArchiveKind)' == 'ps1'">$([System.IO.Path]::GetFileName('$(TestApplicationEntry)'))</_TestArchiveEntry>
            <_TestArchiveReportType>%24null</_TestArchiveReportType>
            <_TestArchiveReportType Condition="'$(TestApplicationReportType)' != ''">%27$(TestApplicationReportType.Replace("'", "''"))%27</_TestArchiveReportType>
            <_TestArchiveReportFile>%24null</_TestArchiveReportFile>
            <_TestArchiveReportFile Condition="'$(TestApplicationReportFile)' != ''">%27$(TestApplicationReportFile.Replace("'", "''"))%27</_TestArchiveReportFile>

            <_TestArchiveRunAlone>%24false</_TestArchiveRunAlone>
            <_TestArchiveRunAlone Condition="'$(TestApplicationRunAlone)' == 'true'">%24true</_TestArchiveRunAlone>

            <!-- The satellite assemblies of the dependencies are most of the files of some applications, and no test reads
                 them. Only the publication of the archive leaves them out, and a value that the project sets is kept. -->
            <_TestArchiveSatelliteResourceLanguages>$(SatelliteResourceLanguages)</_TestArchiveSatelliteResourceLanguages>
            <_TestArchiveSatelliteResourceLanguages Condition="'$(_TestArchiveSatelliteResourceLanguages)' == ''">en</_TestArchiveSatelliteResourceLanguages>

            <_TestArchivePrepare>%24null</_TestArchivePrepare>
            <_TestArchivePrepare Condition="'$(TestApplicationPrepareScript)' != ''">%27$([System.IO.Path]::GetFileName('$(TestApplicationPrepareScript)').Replace("'", "''"))%27</_TestArchivePrepare>

            <_TestArchiveSkip>%24null</_TestArchiveSkip>
            <_TestArchiveSkip Condition="'$(TestApplicationSkip)' != ''">%27$(TestApplicationSkip.Replace("'", "''"))%27</_TestArchiveSkip>
        </PropertyGroup>

        <ItemGroup>
            <_TestArchivePlatform Include="$(TestApplicationPlatforms)" />

            <!-- The extensions registered in the application. The runner passes the options of an extension only when the
                 application has it, because the platform refuses an option that no extension declares. -->
            <_TestArchiveExtension Include="@(TestingPlatformBuilderHook->'%(DisplayName)')" />

            <_TestArchiveTag Include="@(TestApplicationTag)" />

            <!-- Each value becomes a single-quoted PowerShell literal, in which an apostrophe is doubled. The value is quoted
                 with backticks in the expression, which an apostrophe would otherwise end. -->
            <_TestArchivePlatform Literal="$([System.String]::Copy(`%(Identity)`).Replace(&quot;'&quot;, &quot;''&quot;))" />
            <_TestArchiveExtension Literal="$([System.String]::Copy(`%(Identity)`).Replace(&quot;'&quot;, &quot;''&quot;))" />
            <_TestArchiveTag Literal="$([System.String]::Copy(`%(Identity)`).Replace(&quot;'&quot;, &quot;''&quot;))" />
        </ItemGroup>

        <!-- The lists as PowerShell arrays. An item list cannot be concatenated with other text in an item, so it is
             flattened into a property first; %40 is the '@' of the array, which MSBuild would read as an item list. -->
        <PropertyGroup>
            <_TestArchivePlatformList>%40(@(_TestArchivePlatform->'%27%(Literal)%27', ', '))</_TestArchivePlatformList>
            <_TestArchiveExtensionList>%40(@(_TestArchiveExtension->'%27%(Literal)%27', ', '))</_TestArchiveExtensionList>
            <_TestArchiveTagList>%40(@(_TestArchiveTag->'%27%(Literal)%27', ', '))</_TestArchiveTagList>
            <!-- The artifacts are not made items, which would expand their wildcards. -->
            <_TestArchiveArtifactList>%40()</_TestArchiveArtifactList>
            <_TestArchiveArtifactList Condition="'$(TestApplicationArtifacts.Trim())' != ''">%40(%27$(TestApplicationArtifacts.Trim().Trim(';').Replace("'", "''").Replace(';', "', '"))%27)</_TestArchiveArtifactList>
        </PropertyGroup>

        <!-- One item per line. A single multi-line value would be split at every semicolon that a value contains. -->
        <ItemGroup>
            <_TestArchiveManifestLine Include="@{" />
            <_TestArchiveManifestLine Include="%20%20%20%20Name = %27$(AssemblyName)%27" />
            <_TestArchiveManifestLine Include="%20%20%20%20TargetFramework = %27$(TargetFramework)%27" />
            <_TestArchiveManifestLine Include="%20%20%20%20RuntimeIdentifier = %27$(TestApplicationRuntimeIdentifier)%27" />
            <_TestArchiveManifestLine Include="%20%20%20%20Kind = %27$(_TestArchiveKind)%27" />
            <_TestArchiveManifestLine Include="%20%20%20%20Entry = %27$(_TestArchiveEntry)%27" />
            <_TestArchiveManifestLine Include="%20%20%20%20Platforms = $(_TestArchivePlatformList)" />
            <_TestArchiveManifestLine Include="%20%20%20%20Extensions = $(_TestArchiveExtensionList)" />
            <_TestArchiveManifestLine Include="%20%20%20%20Tags = $(_TestArchiveTagList)" />
            <_TestArchiveManifestLine Include="%20%20%20%20TimeoutSeconds = $(TestApplicationTimeoutSeconds)" />
            <_TestArchiveManifestLine Include="%20%20%20%20RunAlone = $(_TestArchiveRunAlone)" />
            <_TestArchiveManifestLine Include="%20%20%20%20Skip = $([MSBuild]::Escape('$(_TestArchiveSkip)'))" />
            <_TestArchiveManifestLine Include="%20%20%20%20Prepare = $([MSBuild]::Escape('$(_TestArchivePrepare)'))" />
            <_TestArchiveManifestLine Include="%20%20%20%20Artifacts = $([MSBuild]::Escape('$(_TestArchiveArtifactList)'))" />
            <_TestArchiveManifestLine Include="%20%20%20%20ReportType = $([MSBuild]::Escape('$(_TestArchiveReportType)'))" Condition="'$(_TestArchiveKind)' == 'ps1'" />
            <_TestArchiveManifestLine Include="%20%20%20%20ReportFile = $([MSBuild]::Escape('$(_TestArchiveReportFile)'))" Condition="'$(_TestArchiveKind)' == 'ps1'" />
        </ItemGroup>

        <!-- A file left by an earlier publication would otherwise be zipped with the current ones. -->
        <RemoveDir Directories="$(_TestArchivePublishDirectory)" />

        <!-- The publication runs in a project instance of its own, so that every property derived from PublishDir is
             evaluated from the directory of the archive. NoBuild publishes the output that the build has just written. -->
        <!-- The second target returns the Packages key of the manifest, which the publication has computed. -->
        <MSBuild Projects="$(MSBuildProjectFullPath)"
                 Targets="Publish;_GetTestArchivePackages"
                 Properties="NoBuild=true;_IsPublishingTestArchive=true;PublishDir=$(_TestArchivePublishDirectory);PublishDocumentationFile=false;PublishReferencesDocumentationFiles=false;SatelliteResourceLanguages=$(_TestArchiveSatelliteResourceLanguages)"
                 Condition="'$(_TestArchiveKind)' == 'mtp'">
            <Output TaskParameter="TargetOutputs" ItemName="_TestArchivePackagesLine" />
        </MSBuild>

        <!-- An archive of the ps1 kind holds its script and the files that the project gives it. -->
        <Error Text="The test archive of '$(MSBuildProjectName)' is of the ps1 kind, and its entry '$(TestApplicationEntry)' does not exist."
               Condition="'$(_TestArchiveKind)' == 'ps1' AND ('$(TestApplicationEntry)' == '' OR !Exists('$(_TestArchiveEntryPath)'))" />
        <ItemGroup Condition="'$(_TestArchiveKind)' == 'ps1'">
            <_TestArchiveContent Include="@(TestApplicationFile)" />
            <_TestArchiveContent Condition="'%(_TestArchiveContent.ArchivePath)' == ''">
                <ArchivePath>%(Filename)%(Extension)</ArchivePath>
            </_TestArchiveContent>
        </ItemGroup>
        <Error Text="The file '%(_TestArchiveContent.FullPath)' of the test archive of '$(MSBuildProjectName)' does not exist."
               Condition="'%(_TestArchiveContent.FullPath)' != '' AND !Exists('%(_TestArchiveContent.FullPath)')" />
        <Copy SourceFiles="$(_TestArchiveEntryPath)" DestinationFolder="$(_TestArchivePublishDirectory)" Condition="'$(_TestArchiveKind)' == 'ps1'" />
        <Copy SourceFiles="@(_TestArchiveContent)" DestinationFiles="@(_TestArchiveContent->'$(_TestArchivePublishDirectory)%(ArchivePath)')" Condition="'$(_TestArchiveKind)' == 'ps1'" />

        <PropertyGroup Condition="'$(TestApplicationPrepareScript)' != ''">
            <_TestArchivePrepareScriptPath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(TestApplicationPrepareScript)'))</_TestArchivePrepareScriptPath>
        </PropertyGroup>

        <Error Text="The prepare script '$(TestApplicationPrepareScript)' of '$(MSBuildProjectName)' does not exist."
               Condition="'$(_TestArchivePrepareScriptPath)' != '' AND !Exists('$(_TestArchivePrepareScriptPath)')" />
        <Copy SourceFiles="$(_TestArchivePrepareScriptPath)"
              DestinationFolder="$(_TestArchivePublishDirectory)"
              Condition="'$(_TestArchivePrepareScriptPath)' != ''" />

        <ItemGroup>
            <_TestArchivePackagesLine Include="%20%20%20%20Packages = %40()" Condition="'@(_TestArchivePackagesLine)' == ''" />
            <_TestArchiveManifestLine Include="@(_TestArchivePackagesLine)" />
            <_TestArchiveManifestLine Include="}" />
        </ItemGroup>

        <WriteLinesToFile File="$(_TestArchivePublishDirectory)test.psd1" Lines="@(_TestArchiveManifestLine)" Overwrite="true" />

        <MakeDir Directories="$(TestArchiveDirectory)" />
        <ZipDirectory SourceDirectory="$(_TestArchivePublishDirectory)" DestinationFile="$(_TestArchiveFile)" Overwrite="true" />

        <Message Importance="high" Text="$(MSBuildProjectName) ($(TargetFramework)) -> $(_TestArchiveFile)" />
    </Target>

    <!--
        In the publication of the archive, the files that come from a package, which are the files under the NuGet package
        root, are removed from the files to copy just before they are copied. The dependency file has been generated at
        that point, and still names them: RunTests.ps1 puts them at the same paths. The rule covers every way a package
        file reaches the output: the runtime, native and resource assets, and the files that the props of a package add.
    -->
    <Target Name="_RemoveTestArchivePackageFiles"
            BeforeTargets="_ComputeResolvedFilesToPublishTypes"
            Condition="'$(_IsPublishingTestArchive)' == 'true' AND '$(NuGetPackageRoot)' != ''">

        <GetTestArchivePackages Files="@(ResolvedFileToPublish)" PackageRoot="$(NuGetPackageRoot)">
            <Output TaskParameter="PackageFiles" ItemName="_TestArchivePackageFile" />
            <Output TaskParameter="Manifest" PropertyName="_TestArchivePackages" />
        </GetTestArchivePackages>

        <ItemGroup>
            <ResolvedFileToPublish Remove="@(_TestArchivePackageFile)" />
        </ItemGroup>
    </Target>

    <Target Name="_GetTestArchivePackages" Returns="@(_TestArchivePackagesLine)">
        <ItemGroup>
            <_TestArchivePackagesLine Include="%20%20%20%20$([MSBuild]::Escape('$(_TestArchivePackages)'))" Condition="'$(_TestArchivePackages)' != ''" />
        </ItemGroup>
    </Target>

    <!--
        Gets the files of a publication that come from a package, and writes the Packages key of the manifest. For each
        package, it gives the identifier and version that name its directory in the package root, the URL of the nupkg when
        the package comes from nuget.org, and each file as its path in the package and its path in the application. NuGet
        writes the source to .nupkg.metadata beside each package that it extracts. The manifest carries no hash of the
        nupkg: a build of the product signs the packages that ship after the archives have recorded them, and the runner
        takes a package by its identifier and version. The task uses no JSON library, because it also runs in the MSBuild
        of Visual Studio.
    -->
    <UsingTask TaskName="GetTestArchivePackages"
               TaskFactory="RoslynCodeTaskFactory"
               AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
            <PackageRoot ParameterType="System.String" Required="true" />
            <PackageFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
            <Manifest ParameterType="System.String" Output="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System" />
            <Using Namespace="System.Collections.Generic" />
            <Using Namespace="System.IO" />
            <Using Namespace="System.Linq" />
            <Using Namespace="System.Text" />
            <Using Namespace="System.Text.RegularExpressions" />
            <Code Type="Fragment" Language="cs"><![CDATA[
const string nugetOrgSource = "https://api.nuget.org/v3/index.json";
const string nugetOrgPackages = "https://api.nuget.org/v3-flatcontainer/";

var root = Path.GetFullPath( PackageRoot ).TrimEnd( '\\', '/' ) + Path.DirectorySeparatorChar;
var packageFiles = new List<ITaskItem>();
var packages = new SortedDictionary<string, List<KeyValuePair<string, string>>>( StringComparer.Ordinal );

foreach ( var file in Files )
{
    var fullPath = Path.GetFullPath( file.GetMetadata( "FullPath" ) );

    if ( !fullPath.StartsWith( root, StringComparison.OrdinalIgnoreCase ) )
    {
        continue;
    }

    // <root>/<id>/<version>/<path in the package>
    var parts = fullPath.Substring( root.Length ).Replace( '\\', '/' ).Split( new[] { '/' }, 3 );

    if ( parts.Length < 3 )
    {
        continue;
    }

    var key = parts[0] + "/" + parts[1];

    if ( !packages.TryGetValue( key, out var list ) )
    {
        packages.Add( key, list = new List<KeyValuePair<string, string>>() );
    }

    list.Add( new KeyValuePair<string, string>( parts[2], file.GetMetadata( "RelativePath" ).Replace( '\\', '/' ) ) );
    packageFiles.Add( file );
}

Func<string, string> quote = value => "'" + value.Replace( "'", "''" ) + "'";

var manifest = new StringBuilder();
manifest.Append( "Packages = @(" );

foreach ( var package in packages )
{
    var id = package.Key.Split( '/' )[0];
    var version = package.Key.Split( '/' )[1];
    var metadataPath = Path.Combine( root, id, version, ".nupkg.metadata" );

    if ( !File.Exists( metadataPath ) )
    {
        Log.LogError( "The test archive cannot reference the package '{0}' {1}: '{2}' does not exist.", id, version, metadataPath );

        continue;
    }

    var source = Regex.Match( File.ReadAllText( metadataPath ), "\"source\"\\s*:\\s*\"([^\"]+)\"" ).Groups[1].Value;

    var url = string.Equals( source.TrimEnd( '/' ), nugetOrgSource, StringComparison.OrdinalIgnoreCase )
        ? quote( nugetOrgPackages + id + "/" + version + "/" + id + "." + version + ".nupkg" )
        : "$null";

    manifest.AppendLine();
    manifest.AppendLine( "        @{" );
    manifest.AppendLine( "            Id = " + quote( id ) );
    manifest.AppendLine( "            Version = " + quote( version ) );
    manifest.AppendLine( "            Url = " + url );
    manifest.Append( "            Files = @(" );

    foreach ( var file in package.Value.OrderBy( f => f.Value, StringComparer.Ordinal ) )
    {
        manifest.AppendLine();
        manifest.Append( "                @{ Path = " + quote( file.Key ) + "; Target = " + quote( file.Value ) + " }" );
    }

    manifest.AppendLine( " )" );
    manifest.Append( "        }" );
}

manifest.Append( " )" );

PackageFiles = packageFiles.ToArray();
Manifest = manifest.ToString();
]]></Code>
        </Task>
    </UsingTask>

</Project>
