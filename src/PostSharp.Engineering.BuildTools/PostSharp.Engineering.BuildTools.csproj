<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <AssemblyName>PostSharp.Engineering.BuildTools</AssemblyName>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <LangVersion>preview</LangVersion>
        <Nullable>enable</Nullable>
        <IsPackable>True</IsPackable>
        <!--  SA0001: XML comment analysis is disabled due to project configuration -->
        <NoWarn>$(NoWarn);SA0001</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AWSSDK.S3" />
        <PackageReference Include="Azure.Identity" />
        <PackageReference Include="Azure.Security.KeyVault.Secrets" />
        <PackageReference Include="JetBrains.Annotations" />
        <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" /> <!-- Resolves version ambiguity. -->
        <!--
            This assembly locates MSBuild at run time with Microsoft.Build.Locator, so every MSBuild assembly must come
            from the registered instance. A copy next to the application wins over the registered instance in the
            assembly loader, and MSBuild then runs against a mixture of versions, which fails with a
            MissingMethodException. ExcludeAssets="runtime" therefore has to be set on every MSBuild package, both here
            and, through the generated nuspec dependencies, in the output directory of every consumer of this package.
        -->
        <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" />
        <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" />
        <PackageReference Include="Microsoft.Build.Locator" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
        <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
        <PackageReference Include="Microsoft.NET.StringTools" ExcludeAssets="runtime" /> <!-- Resolves version ambiguity. Runtime assets excluded, as explained above. -->
        <PackageReference Include="Microsoft.TeamFoundationServer.Client" />
        <PackageReference Include="Newtonsoft.Json" />
        <PackageReference Include="HtmlAgilityPack" />
        <PackageReference Include="NuGet.Versioning" />
        <PackageReference Include="Spectre.Console" />
        <PackageReference Include="Spectre.Console.Cli" />
        <PackageReference Include="System.Configuration.ConfigurationManager" />
        <PackageReference Include="System.Data.SqlClient" /> <!-- Resolves vulnerability. -->
        <PackageReference Include="System.Formats.Asn1" /> <!-- Resolves vulnerability. -->
        <PackageReference Include="System.Management" />
        <PackageReference Include="System.Text.Json" /> <!-- Resolves vulnerability. -->
        <PackageReference Include="Typesense" />
        <PackageReference Include="ModelContextProtocol.AspNetCore" />
        <PackageReference Include="Octokit" />
        <PackageReference Include="Octokit.GraphQL" />
        <PackageReference Include="Microsoft.VisualStudio.Setup.Configuration.Interop" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources\**\*" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="PostSharp.Engineering.BuildTools.Tests" />
    </ItemGroup>

</Project>
