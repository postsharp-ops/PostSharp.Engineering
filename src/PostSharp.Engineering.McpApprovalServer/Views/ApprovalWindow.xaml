<Window x:Class="PostSharp.Engineering.McpApprovalServer.Views.ApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PostSharp.Engineering.McpApprovalServer.ViewModels"
        Title="Command Approval Required"
        Width="800"
        Height="600"
        MinWidth="600"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Topmost="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Y" Modifiers="Alt" Command="{Binding ApproveCommand}" />
        <KeyBinding Key="N" Modifiers="Alt" Command="{Binding RejectCommand}" />
        <KeyBinding Key="Escape" Command="{Binding RejectCommand}" />
    </Window.InputBindings>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header with risk indicator -->
        <Border Grid.Row="0"
                Background="{Binding RiskLevelBrush}"
                CornerRadius="5"
                Padding="10"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="COMMAND APPROVAL REQUIRED"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding RiskLevelText}"
                           FontSize="14"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0" />
            </StackPanel>
        </Border>

        <!-- Command details -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Command:" FontWeight="Bold" Margin="0,5" VerticalAlignment="Top" />
            <TextBox Grid.Row="0" Grid.Column="1"
                     Text="{Binding Command, Mode=OneWay}"
                     IsReadOnly="True"
                     FontFamily="Consolas"
                     Background="#F5F5F5"
                     Margin="0,5"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     MaxHeight="180"
                     MinHeight="24" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Working Dir:" FontWeight="Bold" Margin="0,5" />
            <TextBlock Grid.Row="1" Grid.Column="1"
                       Text="{Binding WorkingDirectory}"
                       FontFamily="Consolas"
                       Margin="0,5" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Git Branch:" FontWeight="Bold" Margin="0,5" />
            <TextBlock Grid.Row="2" Grid.Column="1"
                       Text="{Binding GitBranch}"
                       FontFamily="Consolas"
                       FontWeight="SemiBold"
                       Foreground="#1976D2"
                       Margin="0,5" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Description:" FontWeight="Bold" Margin="0,5" />
            <TextBlock Grid.Row="3" Grid.Column="1"
                       Text="{Binding CommandDescription}"
                       TextWrapping="Wrap"
                       Margin="0,5" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Purpose:" FontWeight="Bold" Margin="0,5" />
            <TextBlock Grid.Row="4" Grid.Column="1"
                       Text="{Binding ClaimedPurpose}"
                       TextWrapping="Wrap"
                       Margin="0,5" />

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Received:" FontWeight="Bold" Margin="0,5" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ReceivedAt}" Margin="0,5" />
        </Grid>

        <!-- Risk assessments in tabs -->
        <TabControl Grid.Row="2" Margin="0,0,0,10">
            <TabItem Header="Combined Assessment">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Risk Level:" FontWeight="Bold" />
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding CombinedAssessment.Level}"
                                       Foreground="{Binding CombinedRiskBrush}"
                                       FontWeight="Bold" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Recommendation:" FontWeight="Bold" Margin="0,5,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding CombinedAssessment.Recommendation}"
                                       Foreground="{Binding CombinedRecommendationBrush}"
                                       FontWeight="Bold"
                                       Margin="0,5,0,0" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Reason:" FontWeight="Bold" Margin="0,5,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="{Binding CombinedAssessment.Reason}"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="AI Assessment">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Risk Level:" FontWeight="Bold" />
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding AiAssessment.Level}"
                                       Foreground="{Binding AiRiskBrush}"
                                       FontWeight="Bold" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Recommendation:" FontWeight="Bold" Margin="0,5,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding AiAssessment.Recommendation}"
                                       Foreground="{Binding AiRecommendationBrush}"
                                       FontWeight="Bold"
                                       Margin="0,5,0,0" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Reason:" FontWeight="Bold" Margin="0,5,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="{Binding AiAssessment.Reason}"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Regex Assessment">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Risk Level:" FontWeight="Bold" />
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding RegexAssessment.Level}"
                                       Foreground="{Binding RegexRiskBrush}"
                                       FontWeight="Bold" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Recommendation:" FontWeight="Bold" Margin="0,5,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding RegexAssessment.Recommendation}"
                                       Foreground="{Binding RegexRecommendationBrush}"
                                       FontWeight="Bold"
                                       Margin="0,5,0,0" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Rule Name:" FontWeight="Bold" Margin="0,5,0,0"
                                       Visibility="{Binding HasRuleName, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="{Binding RegexAssessment.RuleName}"
                                       Margin="0,5,0,0"
                                       Visibility="{Binding HasRuleName, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Reason:" FontWeight="Bold" Margin="0,5,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       Text="{Binding RegexAssessment.Reason}"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Warning for high-risk commands -->
        <Border Grid.Row="3"
                Background="#FFF3E0"
                BorderBrush="#FF9800"
                BorderThickness="1"
                CornerRadius="3"
                Padding="10"
                Margin="0,0,0,10"
                Visibility="{Binding IsHighRisk, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="This command has been flagged as high risk. Please review carefully before approving."
                       Foreground="#E65100"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Action buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="_Approve (Alt+Y)"
                    Command="{Binding ApproveCommand}"
                    Style="{StaticResource ApproveButtonStyle}"
                    Width="150" />
            <Button Content="_Reject (Alt+N)"
                    Command="{Binding RejectCommand}"
                    Style="{StaticResource RejectButtonStyle}"
                    Width="150" />
        </StackPanel>
    </Grid>
</Window>
